import os

X64_SDKS = ("css", "dods", "hl2dm", "tf2")
SUPPORTED_SDKS = X64_SDKS + ("sdk2013", "l4d", "l4d2", "csgo")
PLATFORMS = ("linux", "windows")
ARCHITECTURES = ("x86", "x86_64")


def find_dependency(env_var, folder):
    if env_var in os.environ:
        path = os.environ[env_var]
        return os.path.abspath(path) if os.path.isdir(path) else None

    directory = os.getcwd()
    while True:
        path = os.path.join(directory, folder)
        if os.path.isdir(path):
            return path
        parent = os.path.dirname(directory)
        if directory == parent:
            return None
        directory = parent


class CollisionHookConfig:
    def __init__(self):
        options = builder.options
        self.sm_root = self.dependency_path(
            options.sm_path, "SourceMod",
            ("SOURCEMOD", "sourcemod"), ("SOURCEMOD_DEV", "sourcemod-central"),
        )
        self.mms_root = self.dependency_path(
            options.mms_path, "Metamod:Source",
            ("MMSOURCE110", "mmsource-1.10"), ("MMSOURCE", "metamod-source"),
            ("MMSOURCE_DEV", "mmsource-central"),
        )
        self.sdk_root = os.path.abspath(options.hl2sdk_root) if options.hl2sdk_root else None
        self.sdk_env = {}
        self.debug = options.debug == "1"
        self.optimize = options.opt == "1"
        self.tag = "Debug" if self.debug else "Release"
        self.targets = self.detect_targets(options.targets)
        self.extensions = []
        self.generated_headers = []

    @staticmethod
    def dependency_path(explicit_path, name, *fallbacks):
        if explicit_path:
            if os.path.isdir(explicit_path):
                return os.path.abspath(explicit_path)
        else:
            for env_var, folder in fallbacks:
                path = find_dependency(env_var, folder)
                if path is not None:
                    return path
        raise FileNotFoundError(f"Could not find a source copy of {name}")

    @staticmethod
    def detect_targets(requested_targets):
        targets = []
        for arch in requested_targets.split(",") if requested_targets else ARCHITECTURES:
            if arch not in ARCHITECTURES:
                raise ValueError(f"Unsupported target architecture: {arch}")
            try:
                cxx = builder.DetectCxx(target_arch=arch)
            except Exception as error:
                if requested_targets:
                    raise
                print(f"Skipping target {arch}: {error}")
                continue
            if cxx.target.platform not in PLATFORMS:
                raise ValueError("CollisionHook supports Linux and Windows.")
            targets.append(cxx)

        if not targets:
            raise RuntimeError("No suitable C/C++ compiler was found.")
        return targets

    def filter_sdk(self, sdk):
        name = sdk["name"]
        if name not in SUPPORTED_SDKS:
            return False

        # The shared manifests also describe unsupported combinations, including
        # the Linux x64 CS:GO listen server.
        self.sdk_env[name] = sdk["env_var"]
        architectures = ARCHITECTURES if name in X64_SDKS else ("x86",)
        sdk["platforms"] = {
            platform: [arch for arch in architectures if arch in sdk["platforms"].get(platform, ())]
            for platform in PLATFORMS
        }
        return True

    def find_sdk_path(self, name):
        folder = f"hl2sdk-{name}"
        if self.sdk_root:
            path = os.path.join(self.sdk_root, folder)
            return path if os.path.isdir(path) else None
        return find_dependency(self.sdk_env[name], folder)

    def configure_compiler(self, cxx):
        cxx.defines += ["HAVE_STRING_H"]
        if self.debug:
            cxx.defines += ["DEBUG", "_DEBUG"]
        if self.optimize:
            cxx.defines += ["NDEBUG"]

        if cxx.like("gcc"):
            cxx.defines += ["HAVE_STDINT_H", "typeof=__typeof__", "_FILE_OFFSET_BITS=64"]
            cxx.cflags += [
                "-pipe", "-fno-strict-aliasing", "-Wall", "-Wno-unused",
                "-Wno-switch", "-Wno-array-bounds", "-msse", "-fPIC", "-fvisibility=hidden",
            ]
            cxx.cxxflags += [
                "-std=c++17", "-fno-threadsafe-statics", "-fvisibility-inlines-hidden",
                "-Wno-non-virtual-dtor", "-Wno-overloaded-virtual", "-fpermissive",
            ]
            cxx.linkflags += ["-Wl,--exclude-libs,ALL", "-static-libstdc++"]
            if cxx.family == "clang":
                cxx.cxxflags += [
                    "-Wno-implicit-exception-spec-mismatch", "-Wno-register",
                    "-Wno-expansion-to-defined", "-Wno-inconsistent-missing-override",
                ]
                cxx.linkflags += ["-lgcc_eh"]
            else:
                cxx.cflags += ["-mfpmath=sse"]
                cxx.linkflags += ["-static-libgcc"]
            if self.optimize:
                cxx.cflags += ["-O3"]
        elif cxx.like("msvc"):
            cxx.defines += [
                "_WINDOWS", "_CRT_SECURE_NO_DEPRECATE", "_CRT_SECURE_NO_WARNINGS",
                "_CRT_NONSTDC_NO_DEPRECATE", "_ITERATOR_DEBUG_LEVEL=0",
            ]
            cxx.cflags += ["/W3", "/MTd" if self.debug else "/MT"]
            cxx.cxxflags += ["/EHsc", "/std:c++17"]
            if self.optimize:
                cxx.cflags += ["/Ox", "/Zo"]
                cxx.linkflags += ["/OPT:ICF", "/OPT:REF"]
            if self.debug:
                cxx.cflags += ["/Od", "/RTC1"]
                cxx.linkflags += ["/NODEFAULTLIB:libcmt"]
            cxx.cflags += ["/Oy-"]


Extension = CollisionHookConfig()
manifest_helper = os.path.join(Extension.sm_root, "hl2sdk-manifests", "SdkHelpers.ambuild")
if not os.path.isfile(manifest_helper):
    raise FileNotFoundError("Initialize SourceMod's hl2sdk-manifests submodule.")

SdkHelpers = builder.Eval(manifest_helper, {"Project": "sm-extension"})
SdkHelpers.sdk_filter = Extension.filter_sdk
SdkHelpers.find_sdk_path = Extension.find_sdk_path

# Keep an unconfigured compiler for each SafetyHook library.
sdk_compilers = [cxx.clone() for cxx in Extension.targets]
for cxx in sdk_compilers:
    Extension.configure_compiler(cxx)

sdk_selection = builder.options.sdks.split()
if not sdk_selection:
    raise ValueError("Specify SDK names, 'all', or 'present'.")
if sdk_selection[0] in ("all", "present"):
    sdk_selection = sdk_selection[:1]
else:
    unknown_sdks = sorted(set(sdk_selection) - set(SUPPORTED_SDKS))
    if unknown_sdks:
        raise ValueError(f"Unsupported SDKs: {', '.join(unknown_sdks)}")
    if all(cxx.target.arch == "x86_64" for cxx in sdk_compilers):
        sdk_selection = [name for name in sdk_selection if name in X64_SDKS]
        if not sdk_selection:
            raise ValueError("None of the selected SDKs support x86_64.")
SdkHelpers.findSdks(builder, sdk_compilers, sdk_selection)

if builder.options.version or not builder.options.disable_auto_versioning:
    Extension.generated_headers = builder.Build("buildbot/Versioning")

builder.Build("src/AMBuilder", {"Extension": Extension, "SdkHelpers": SdkHelpers})
builder.Build("buildbot/PackageScript", {"Extension": Extension})
