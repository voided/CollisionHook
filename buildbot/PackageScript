import os

builder.SetBuildFolder("package")

sourcemod_folder = os.path.join("addons", "sourcemod")
folders = {
    path: builder.AddFolder(os.path.join(sourcemod_folder, path))
    for path in ("extensions", "extensions/x64", "gamedata", "scripting/include")
}

with open(os.path.join(builder.buildPath, "pdblog.txt"), "w") as pdblog:
    for task in Extension.extensions:
        folder = "extensions/x64" if task.target.arch == "x86_64" else "extensions"
        builder.AddCopy(task.binary, folders[folder])
        pdblog.write(task.debug.path + "\n")

for folder, filename in (
    ("gamedata", "collisionhook.txt"),
    ("scripting/include", "collisionhook.inc"),
):
    builder.AddCopy(os.path.join(builder.sourcePath, "sourcemod", folder, filename), folders[folder])
