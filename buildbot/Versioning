import os
import subprocess
import sys

builder.SetBuildFolder("/")
builder.AddFolder("includes")

source = builder.sourcePath
output = os.path.join(builder.buildPath, "includes")
script = os.path.join(source, "buildbot", "generate_header.py")
argv = [sys.executable, script, source, output]
sources = [script]
if builder.options.version:
    argv.append(builder.options.version)
else:
    sources.append(os.path.join(source, "product.version"))
    head_ref = subprocess.run(
        ["git", "symbolic-ref", "--quiet", "HEAD"], cwd=source, text=True, capture_output=True
    ).stdout.strip()
    for ref in ("HEAD", head_ref):
        if not ref:
            continue
        path = subprocess.check_output(
            ["git", "rev-parse", "--git-path", ref], cwd=source, text=True
        ).strip()
        path = os.path.join(source, path)
        if os.path.isfile(path):
            sources.append(path)

rvalue = builder.AddCommand(
    inputs=sources,
    argv=argv,
    outputs=["includes/version_auto.h", "includes/filename_versioning.txt"],
)
